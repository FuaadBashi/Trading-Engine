{
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.path": "/opt/homebrew/opt/llvm/bin/clangd",
    "clangd.arguments": [
        // The repo root, not build/. CMakeLists copies compile_commands.json here from whichever
        // directory you configured, so this stays current wherever you build -- and the canonical
        // build now lives outside the iCloud-synced tree (~/build/TradingEngineProject), which a
        // ${workspaceFolder}-relative path cannot reach. Pointing at build/ pinned clangd to a
        // stale database that predated new source files, so they showed as unresolved includes.
        "--compile-commands-dir=${workspaceFolder}",
        "--background-index",
        "--header-insertion=never"
    ],
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.analysis.extraPaths": [
        "${workspaceFolder}/.venv/lib/python3.9/site-packages"
    ],
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "python-envs.pythonProjects": []
}
